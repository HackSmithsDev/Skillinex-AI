{
  "expo": {
    "name": "Skillinex",
    "slug": "skillinex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "dev.hacksmiths.skillinex",
      "appleTeamId": "WS542VN5TH"
    },
    "android": {
      "package": "dev.hacksmiths.skillinex",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "favicon": "./assets/favicon.svg"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      "expo-status-bar"
    ]
  }
}
