# --- Server Runtime ---
HOST=127.0.0.1
PORT=8008
DEBUG=True
WORKERS_COUNT=4

# --- Frontend Access ---
FRONTEND_URL=

# --- Core Security ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database & Cache ---
# Works with either a Neon pooled URL (postgresql://...?sslmode=require&channel_binding=require)
# or a plain local Postgres URL — swap this value and the app adapts automatically.
DATABASE_URL=postgresql+asyncpg://<your_db_user>:<your_db_password>@localhost:5432/skillinex
REDIS_URL=redis://127.0.0.1:6379

# --- AI Infrastructure ---
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash

# --- SMTP / Email Logic ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Skillinex AI Official
MAIL_SERVER=smtpout.secureserver.net
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True

# --- Admin Monitoring ---
ADMIN_EMAIL=