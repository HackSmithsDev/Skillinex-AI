# --- Server Runtime ---
# Pulling these into main.py via settings.HOST/PORT
HOST=host_ip_here
PORT=port_number_here
DEBUG=True
WORKERS_COUNT=4

# --- Frontend Access ---
# Used for URL generation in emails (Verify, Reset, Dashboard)
BACKEND_CORS_ORIGINS=[your_frontend_url_here]

# --- Core Security ---
# Generate a real key using: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours for development

# --- Database & Cache ---
# Using asyncpg driver for PostgreSQL
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name
REDIS_URL=redis://localhost:6379/0

# --- AI Infrastructure ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- SMTP / Email Logic ---
# These must match app/workers/tasks/email/__init__.py
MAIL_USERNAME=your_username_here
MAIL_PASSWORD=your_password_here
MAIL_FROM=your_email_here
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# --- Admin Monitoring ---
ADMIN_EMAIL=your_admin_email_here