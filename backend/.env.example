# --- Server Runtime ---
# Pulling these into main.py via settings.HOST/PORT
HOST=host_ip_here
PORT=port_number_here
DEBUG=True
WORKERS_COUNT=4

# --- Frontend Access ---
# Used for URL generation in emails (Verify, Reset, Dashboard)
BACKEND_CORS_ORIGINS=[your_frontend_url_here]

# --- Core Security ---
# Generate a real key using: openssl rand -hex 32
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours for development

# --- Database & Cache ---
# Accepts a Neon pooled URL (postgresql://...?sslmode=require&channel_binding=require)
# or a plain local Postgres URL; ASYNC_DATABASE_URL normalizes either automatically.
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name
REDIS_URL=redis://localhost:6379/0

# --- Cloudflare Tunnel (Docker/Render deployment only) ---
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- AI Infrastructure ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- SMTP / Email Logic ---
# Use MAIL_USE_TLS=True + port 587 for Gmail-style STARTTLS,
# or MAIL_USE_SSL=True + port 465 for direct-SSL providers (e.g. GoDaddy).
MAIL_USERNAME=your_username_here
MAIL_PASSWORD=your_password_here
MAIL_FROM=your_email_here
MAIL_FROM_NAME=Skillinex AI
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False

# --- Admin Monitoring ---
ADMIN_EMAIL=your_admin_email_here